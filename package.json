{
  "name": "prodio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @prodio/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:test": "bash supabase/tests/run.sh",
    "db:test:api": "bash supabase/tests/api.sh",
    "db:test:migracoes": "bash supabase/tests/migracoes.sh",
    "db:aplicar": "bash supabase/aplicar-migracoes.sh",
    "deploy:web": "pnpm --filter @prodio/web deploy:pages",
    "deploy:worker": "pnpm --filter @prodio/worker deploy:workers"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
