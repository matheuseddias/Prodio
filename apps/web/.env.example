# Todas as VITE_* são lidas no BUILD e ficam embutidas no JavaScript entregue ao navegador.
# Qualquer pessoa consegue lê-las no bundle: nunca coloque aqui a service_role key nem segredo
# de conector. Ver docs/deploy-web.md.

# Sem estas variáveis o app roda em modo memória (dados de exemplo, sem login).
# URL e anon key do projeto Supabase (a anon key só serve para autenticar; tudo passa pela RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# URL pública do Cloudflare Worker (upload de XML, credenciais de conectores, callback de OAuth).
VITE_WORKER_URL=
# Domínio que recebe XML de NF-e por e-mail (xml@<slug>.<domínio>). Tem que ser o mesmo
# domínio configurado no Email Routing da Cloudflare apontando para o worker.
# VITE_DOMINIO_EMAIL_XML=prodio.com.br
# Opcional: usar HashRouter (hospedagem estática sem rewrite).
# No Cloudflare Pages não precisa: o public/_redirects já faz o rewrite para o index.html.
# VITE_HASH_ROUTER=1
